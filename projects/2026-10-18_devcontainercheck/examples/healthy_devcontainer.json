{
  "name": "example-dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.12@sha256:1111111111111111111111111111111111111111111111111111111111111111",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1@sha256:2222222222222222222222222222222222222222222222222222222222222222": {}
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "containerEnv": {
    "APP_ENV": "development",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.cache,target=/workspaces/.cache,type=bind"
  ]
}
